generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Order {
  id              String   @id @default(cuid())
  orderId         String   @unique // ORD-2026001 style
  targetLink      String
  clientName      String?
  chatLink        String?
  platform        String   // ig, tiktok, fb, etc.
  service         String   // ฟอล, ไลค์, วิว, etc.
  serviceType     String?  // ต่างชาติ, ผสม, ไทย
  price           Float?   // ราคา
  
  // Counts
  originalCount   Int?     // ยอดเดิม
  
  // Foreign Followers (ต่างชาติ)
  foreignAmount   Int?     // เพิ่มฟอลต่างชาติ
  foreignBonus    Int?     // แถม
  foreignDone     Int?     // ทำไปแล้ว
  // foreignRemaining is calculated: (foreignAmount + foreignBonus) - foreignDone
  
  // Thai Followers (ไทย)
  thaiAmount      Int?     // เพิ่มฟอลไทย
  thaiBonus       Int?     // แถม
  thaiDone        Int?     // ทำไปแล้ว
  // thaiRemaining is calculated: (thaiAmount + thaiBonus) - thaiDone
  
  totalAmount     Int?     // ยอดรวม
  startDate       DateTime? // วันที่เริ่ม
  endDate         DateTime? // วันที่สิ้นสุด
  timeSpent       String?   // เวลาที่ใช้ไป
  
  status          String   @default("pending") // waiting (รับยอด), pending (รอดำเนินการ), working (กำลังทำ), completed (เสร็จรอส่ง), done (ส่งงานแล้ว)
  speed           String?  @default("normal")  // ความเร็ว: normal (ปกติ), urgent (เร่งด่วน), drip (ทยอยทำ)
  notes           String?  @db.Text            // หมายเหตุ

  // Authentication
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // New Financial & Advanced Tracking Fields
  providerLink          String?  // ลิงก์เว็บปั๊ม (เว็บของผู้ให้บริการ)
  targetPlatformAmount  Int?     // จำนวนที่ต้องการปั๊ม (จากเว็บผู้ให้บริการ)
  feePercentage         Float?   @default(13.0) // หักค่าธรรมเนียม (%)
  feeAmount             Float?   // จำนวนเงินค่าธรรมเนียมที่ถูกหัก
  netRevenue            Float?   // รับสุทธิ (Price - FeeAmount)
  totalCost             Float?   // ต้นทุนรวม (จาก BoostHistory)
  profit                Float?   // กำไร (NetRevenue - TotalCost)

  boostHistories  BoostHistory[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BoostHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Int      // จำนวนที่ปั๊มในครั้งนี้
  cost      Float    // ต้นทุนครั้งนี้
  note      String?  @db.Text // บันทึกย่อ
  createdAt DateTime @default(now())
}

// NextAuth.js Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

